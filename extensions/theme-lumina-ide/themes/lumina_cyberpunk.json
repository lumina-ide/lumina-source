	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#3d0055", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "keyword.control", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.instanceof", "keyword.operator.wordlike"],
			"settings": { "foreground": "#ff2d78" }
		},
		{
			"name": "Storage types",
			"scope": ["storage", "storage.type"],
			"settings": { "foreground": "#ff2d78" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#9966bb" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#00fff9" }
		},
		{
			"name": "Types and Classes",
			"scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace"],
			"settings": { "foreground": "#bf00ff" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other.readwrite"],
			"settings": { "foreground": "#f0e6ff" }
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#cc88ff" }
		},
		{
			"name": "Language variables",
			"scope": ["variable.language"],
			"settings": { "foreground": "#ff2d78", "fontStyle": "italic" }
		},
		{
			"name": "Constants",
			"scope": ["constant.language", "variable.other.constant"],
			"settings": { "foreground": "#ffe600" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric", "variable.other.enummember"],
			"settings": { "foreground": "#ffe600" }
		},
		{
			"name": "Strings",
			"scope": ["string", "meta.embedded.assembly"],
			"settings": { "foreground": "#ff9de2" }
		},
		{
			"name": "String escape",
			"scope": ["constant.character.escape", "punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end"],
			"settings": { "foreground": "#00fff9" }
		},
		{
			"name": "Regex",
			"scope": ["string.regexp"],
			"settings": { "foreground": "#ffe600" }
		},
		{
			"name": "HTML/XML Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#ff2d78" }
		},
		{
			"name": "HTML/XML Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#bf00ff" }
		},
		{
			"name": "CSS Properties",
			"scope": ["support.type.property-name", "support.type.vendored.property-name"],
			"settings": { "foreground": "#00fff9" }
		},
		{
			"name": "CSS Units",
			"scope": ["keyword.other.unit"],
			"settings": { "foreground": "#ffe600" }
		},
		{
			"name": "Decorators",
			"scope": ["meta.decorator", "punctuation.decorator"],
			"settings": { "foreground": "#ffe600", "fontStyle": "italic" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#ff2d78" }
		},
		{
			"name": "Tag punctuation",
			"scope": ["punctuation.definition.tag"],
			"settings": { "foreground": "#3d0055" }
		},
		{
			"name": "Markdown Headings",
			"scope": ["markup.heading"],
			"settings": { "foreground": "#ff2d78", "fontStyle": "bold" }
		},
		{
			"name": "Markdown Code",
			"scope": ["markup.inline.raw"],
			"settings": { "foreground": "#00fff9" }
		},
		{
			"name": "Diff Inserted",
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#00fff9" }
		},
		{
			"name": "Diff Deleted",
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#ff2d78" }
		},
		{
			"name": "Diff Changed",
			"scope": ["markup.changed"],
			"settings": { "foreground": "#ffe600" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#bf00ff",
		"class": "#bf00ff",
		"interface": "#cc66ff",
		"enum": "#cc66ff",
		"enumMember": "#ffe600",
		"typeParameter": "#cc66ff",
		"function": "#00fff9",
		"method": "#00fff9",
		"property": "#f0e6ff",
		"variable": "#f0e6ff",
		"variable.readonly": "#ffe600",
		"parameter": "#cc88ff",
		"keyword": "#ff2d78",
		"string": "#ff9de2",
		"number": "#ffe600",
		"regexp": "#ffe600",
		"operator": "#9966bb",
		"newOperator": "#f0e6ff",
		"stringLiteral": "#ff9de2",
		"numberLiteral": "#ffe600"
	}
}
