	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#9ca3af", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "keyword.control", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.instanceof", "keyword.operator.wordlike"],
			"settings": { "foreground": "#0066ff" }
		},
		{
			"name": "Storage types",
			"scope": ["storage", "storage.type"],
			"settings": { "foreground": "#0066ff" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#6b7280" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#0891b2" }
		},
		{
			"name": "Types and Classes",
			"scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace"],
			"settings": { "foreground": "#7c3aed" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other.readwrite"],
			"settings": { "foreground": "#1a1d23" }
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#374151" }
		},
		{
			"name": "Language variables",
			"scope": ["variable.language"],
			"settings": { "foreground": "#0066ff", "fontStyle": "italic" }
		},
		{
			"name": "Constants",
			"scope": ["constant.language", "variable.other.constant"],
			"settings": { "foreground": "#7c3aed" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric", "variable.other.enummember"],
			"settings": { "foreground": "#16a34a" }
		},
		{
			"name": "Strings",
			"scope": ["string", "meta.embedded.assembly"],
			"settings": { "foreground": "#d97706" }
		},
		{
			"name": "String escape",
			"scope": ["constant.character.escape", "punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end"],
			"settings": { "foreground": "#0066ff" }
		},
		{
			"name": "Regex",
			"scope": ["string.regexp"],
			"settings": { "foreground": "#d97706" }
		},
		{
			"name": "HTML/XML Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#0066ff" }
		},
		{
			"name": "HTML/XML Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#7c3aed" }
		},
		{
			"name": "CSS Properties",
			"scope": ["support.type.property-name", "support.type.vendored.property-name"],
			"settings": { "foreground": "#0891b2" }
		},
		{
			"name": "CSS Units",
			"scope": ["keyword.other.unit"],
			"settings": { "foreground": "#16a34a" }
		},
		{
			"name": "Decorators",
			"scope": ["meta.decorator", "punctuation.decorator"],
			"settings": { "foreground": "#7c3aed", "fontStyle": "italic" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#e5193a" }
		},
		{
			"name": "Tag punctuation",
			"scope": ["punctuation.definition.tag"],
			"settings": { "foreground": "#9ca3af" }
		},
		{
			"name": "Markdown Headings",
			"scope": ["markup.heading"],
			"settings": { "foreground": "#0066ff", "fontStyle": "bold" }
		},
		{
			"name": "Markdown Code",
			"scope": ["markup.inline.raw"],
			"settings": { "foreground": "#0891b2" }
		},
		{
			"name": "Diff Inserted",
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#16a34a" }
		},
		{
			"name": "Diff Deleted",
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#e5193a" }
		},
		{
			"name": "Diff Changed",
			"scope": ["markup.changed"],
			"settings": { "foreground": "#0066ff" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#7c3aed",
		"class": "#7c3aed",
		"interface": "#8b5cf6",
		"enum": "#8b5cf6",
		"enumMember": "#16a34a",
		"typeParameter": "#8b5cf6",
		"function": "#0891b2",
		"method": "#0891b2",
		"property": "#1a1d23",
		"variable": "#1a1d23",
		"variable.readonly": "#7c3aed",
		"parameter": "#374151",
		"keyword": "#0066ff",
		"string": "#d97706",
		"number": "#16a34a",
		"regexp": "#d97706",
		"operator": "#6b7280",
		"newOperator": "#1a1d23",
		"stringLiteral": "#d97706",
		"numberLiteral": "#16a34a"
	}
}
