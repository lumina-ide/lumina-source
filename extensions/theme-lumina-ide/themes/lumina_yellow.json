	"semanticHighlighting": true,
	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment"],
			"settings": {"fontStyle": "italic", "foreground": "#7c6f64"}
		},
		{
			"name": "String",
			"scope": ["string", "constant.other.symbol"],
			"settings": {"foreground": "#b8bb26"}
		},
		{
			"name": "Number",
			"scope": ["constant.numeric"],
			"settings": {"foreground": "#d3869b"}
		},
		{
			"name": "Built-in constants",
			"scope": ["constant.language"],
			"settings": {"foreground": "#fabd2f"}
		},
		{
			"name": "Variable",
			"scope": ["variable"],
			"settings": {"foreground": "#ebdbb2"}
		},
		{
			"name": "Language variable",
			"scope": ["variable.language"],
			"settings": {"fontStyle": "italic", "foreground": "#fabd2f"}
		},
		{
			"name": "Storage",
			"scope": ["storage"],
			"settings": {"foreground": "#fabd2f"}
		},
		{
			"name": "Storage type",
			"scope": ["storage.type"],
			"settings": {"foreground": "#fb4934", "fontStyle": "italic"}
		},
		{
			"name": "Keyword",
			"scope": ["keyword"],
			"settings": {"foreground": "#fb4934"}
		},
		{
			"name": "Keyword operator",
			"scope": ["keyword.operator"],
			"settings": {"foreground": "#8ec07c"}
		},
		{
			"name": "Separators",
			"scope": ["punctuation.separator", "punctuation.terminator"],
			"settings": {"foreground": "#928374"}
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation.section"],
			"settings": {"foreground": "#ebdbb2"}
		},
		{
			"name": "Type",
			"scope": ["entity.name.type"],
			"settings": {"foreground": "#fe8019"}
		},
		{
			"name": "Function name",
			"scope": ["entity.name.function"],
			"settings": {"foreground": "#fabd2f"}
		},
		{
			"name": "Tag",
			"scope": ["entity.name.tag"],
			"settings": {"foreground": "#8ec07c"}
		},
		{
			"name": "Tag attribute",
			"scope": ["entity.other.attribute-name"],
			"settings": {"foreground": "#fabd2f", "fontStyle": "italic"}
		},
		{
			"name": "Library class/type",
			"scope": ["support.type", "support.class"],
			"settings": {"foreground": "#fe8019"}
		},
		{
			"name": "Library function",
			"scope": ["support.function"],
			"settings": {"foreground": "#fabd2f"}
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": {"foreground": "#fb3934"}
		},
		{
			"name": "Markup heading",
			"scope": ["markup.heading"],
			"settings": {"fontStyle": "bold", "foreground": "#8ec07c"}
		}
	],
	"semanticTokenColors": {
		"namespace": "#fe8019",
		"class": "#fe8019",
		"interface": "#fe8019",
		"enum": "#fabd2f",
		"typeParameter": "#fabd2f",
		"function": "#fabd2f",
		"method": "#fabd2f",
		"property": "#ebdbb2",
		"variable": "#ebdbb2",
		"variable.readonly": "#fabd2f",
		"parameter": "#83a598",
		"keyword": "#fb4934",
		"string": "#b8bb26",
		"number": "#d3869b",
		"regexp": "#fe8019",
		"operator": "#8ec07c"
	}
