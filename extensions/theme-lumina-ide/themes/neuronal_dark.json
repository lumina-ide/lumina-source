	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#1e4060", "fontStyle": "italic" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "keyword.control", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.instanceof", "keyword.operator.wordlike"],
			"settings": { "foreground": "#00c8f0" }
		},
		{
			"name": "Storage types",
			"scope": ["storage", "storage.type"],
			"settings": { "foreground": "#00c8f0" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#5a7a90" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
			"settings": { "foreground": "#40d8f8" }
		},
		{
			"name": "Types and Classes",
			"scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace"],
			"settings": { "foreground": "#7b4fff" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other.readwrite"],
			"settings": { "foreground": "#c8dce8" }
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#9ab8cc" }
		},
		{
			"name": "Language variables (this, self)",
			"scope": ["variable.language"],
			"settings": { "foreground": "#00c8f0", "fontStyle": "italic" }
		},
		{
			"name": "Constants",
			"scope": ["constant.language", "variable.other.constant"],
			"settings": { "foreground": "#9b6fff" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric", "variable.other.enummember"],
			"settings": { "foreground": "#00c8a0" }
		},
		{
			"name": "Strings",
			"scope": ["string", "meta.embedded.assembly"],
			"settings": { "foreground": "#4a90d9" }
		},
		{
			"name": "String escape and template",
			"scope": ["constant.character.escape", "punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end"],
			"settings": { "foreground": "#00c8f0" }
		},
		{
			"name": "Regex",
			"scope": ["string.regexp"],
			"settings": { "foreground": "#f0a030" }
		},
		{
			"name": "HTML/XML Tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#00c8f0" }
		},
		{
			"name": "HTML/XML Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#7b4fff" }
		},
		{
			"name": "CSS Properties",
			"scope": ["support.type.property-name", "support.type.vendored.property-name"],
			"settings": { "foreground": "#40d8f8" }
		},
		{
			"name": "CSS Units",
			"scope": ["keyword.other.unit"],
			"settings": { "foreground": "#00c8a0" }
		},
		{
			"name": "Decorators",
			"scope": ["meta.decorator", "punctuation.decorator"],
			"settings": { "foreground": "#9b6fff", "fontStyle": "italic" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#ff4a6a" }
		},
		{
			"name": "Tag punctuation",
			"scope": ["punctuation.definition.tag"],
			"settings": { "foreground": "#2a4a60" }
		},
		{
			"name": "Markdown Headings",
			"scope": ["markup.heading"],
			"settings": { "foreground": "#00c8f0", "fontStyle": "bold" }
		},
		{
			"name": "Markdown Bold",
			"scope": ["markup.bold"],
			"settings": { "foreground": "#c8dce8", "fontStyle": "bold" }
		},
		{
			"name": "Markdown Italic",
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"name": "Markdown Code",
			"scope": ["markup.inline.raw"],
			"settings": { "foreground": "#40d8f8" }
		},
		{
			"name": "Diff Inserted",
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#00c8a0" }
		},
		{
			"name": "Diff Deleted",
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#ff4a6a" }
		},
		{
			"name": "Diff Changed",
			"scope": ["markup.changed"],
			"settings": { "foreground": "#7b4fff" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#7b4fff",
		"class": "#7b4fff",
		"interface": "#9b6fff",
		"enum": "#9b6fff",
		"enumMember": "#00c8a0",
		"typeParameter": "#9b6fff",
		"function": "#40d8f8",
		"method": "#40d8f8",
		"property": "#c8dce8",
		"variable": "#c8dce8",
		"variable.readonly": "#9b6fff",
		"parameter": "#9ab8cc",
		"keyword": "#00c8f0",
		"string": "#4a90d9",
		"number": "#00c8a0",
		"regexp": "#f0a030",
		"operator": "#5a7a90",
		"newOperator": "#c8dce8",
		"stringLiteral": "#4a90d9",
		"numberLiteral": "#00c8a0"
	}
}
